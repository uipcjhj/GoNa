# ─────────────────────────────────────────────────────────────
# Global Opportunity Radar — 환경변수 (비밀키는 절대 Git에 올리지 마세요)
# 로컬: 이 파일을 .env.local 로 복사 후 값 입력
# Vercel: Project → Settings → Environment Variables 에 동일하게 입력
# ─────────────────────────────────────────────────────────────

# [필수 - 운영] Supabase (무료 플랜 가능) — Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# [선택] 무료 Gemini AI 기사분석 — https://aistudio.google.com/apikey
# Gemini 키가 있으면 Gemini를 우선 사용합니다. 별도 청구가 없는 무료 등급 프로젝트로 시작하세요.
# 무료 등급에도 호출량 제한이 있으며 Google의 데이터 사용 정책을 확인하세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# [선택] AI 분석 (Anthropic Claude) — https://console.anthropic.com → API Keys
# 미설정 시 규칙 기반 분석으로 동작 (정확도 제한)
ANTHROPIC_API_KEY=
# 선택: 모델 변경 (기본 claude-opus-5-5 / 저비용: claude-haiku-5-5)
ANTHROPIC_MODEL=

# [필수 - 자동 수집] 예약 실행 보호용 임의 문자열 (예: 32자 이상 랜덤 문자열)
CRON_SECRET=

# [권장] 관리자 비밀번호 (설정 시 로그인 화면 활성화) — 수집·분석·편집·설정 모든 기능
APP_PASSWORD=
# [선택] 팀원 공유용 읽기 전용 비밀번호 — 대시보드·수주기회·주간 업계동향·뉴스·경쟁사 조회만 가능
VIEWER_PASSWORD=
# [선택] 비밀번호 원문 대신 해시 사용: `npm run hash-password` 출력값을 넣으면 위 원문 변수는 비워도 됨
# APP_PASSWORD_HASH=
# VIEWER_PASSWORD_HASH=
# [선택] 세션 서명 키 (16자 이상 임의 문자열). 비우면 비밀번호에서 자동 생성 — 비밀번호를 바꾸면 모든 세션 로그아웃
# SESSION_SECRET=

# [선택] 추가 뉴스 소스 GNews (무료 100회/일) — https://gnews.io
GNEWS_API_KEY=
