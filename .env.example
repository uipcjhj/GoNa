# ─────────────────────────────────────────────────────────────
# Global Opportunity Radar — 환경변수 (비밀키는 절대 Git에 올리지 마세요)
# 로컬: 이 파일을 .env.local 로 복사 후 값 입력
# Vercel: Project → Settings → Environment Variables 에 동일하게 입력
# ─────────────────────────────────────────────────────────────

# [필수 - 운영] Supabase (무료 플랜 가능) — Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# [권장] AI 분석 (Anthropic Claude) — https://console.anthropic.com → API Keys
# 미설정 시 규칙 기반 분석으로 동작 (정확도 제한)
ANTHROPIC_API_KEY=
# 선택: 모델 변경 (기본 claude-opus-5-5 / 저비용: claude-haiku-5-5)
ANTHROPIC_MODEL=

# [필수 - 자동 수집] 예약 실행 보호용 임의 문자열 (예: 32자 이상 랜덤 문자열)
CRON_SECRET=

# [권장] 사이트 접속 비밀번호 (설정 시 로그인 화면 활성화)
APP_PASSWORD=

# [선택] 추가 뉴스 소스 GNews (무료 100회/일) — https://gnews.io
GNEWS_API_KEY=
